  "formatCases": [
    {
      "id": "string-right-width-precision",
      "kind": "text",
      "format": "[%6.3s]",
      "value": "WXYZ",
      "expectedExpanded": "[   WXY]"
    },
    {
      "id": "string-left-width-precision",
      "kind": "text",
      "format": "[%-6.3s]",
      "value": "WXYZ",
      "expectedExpanded": "[WXY   ]"
    },
    {
      "id": "string-percent-escape",
      "kind": "text",
      "format": "%%:%s",
      "value": "Z",
      "expectedExpanded": "%:Z"
    },
    {
      "id": "string-value-stops-at-NUL",
      "kind": "text",
      "format": "<%s>",
      "value": "a\u0000b",
      "expectedExpanded": "<a>"
    },
    {
      "id": "expanded-value-commands-are-processed",
      "kind": "text",
      "format": "[%s]",
      "value": "\\X3\\+0",
      "expectedExpanded": "[\\X3\\+0]",
      "expectedUnits": [
        91,
        93
      ],
      "expectedRegister0": 3
    },
    {
      "id": "binary-four-little-endian-bytes",
      "kind": "binary",
      "format": "<%s>",
      "value": 305419896,
      "expectedExpanded": "<\\78\\56\\34\\12>",
      "expectedUnits": [
        60,
        120,
        86,
        52,
        18,
        62
      ]
    },
    {
      "id": "binary-preserves-NUL-byte",
      "kind": "binary",
      "format": "%s",
      "value": 256,
      "expectedExpanded": "\\00\\01\\00\\00",
      "expectedUnits": [
        0,
        1,
        0,
        0
      ]
    },
    {
      "id": "binary-width-is-not-recognized",
      "kind": "binary",
      "format": "%4s",
      "value": 1,
      "expectedExpanded": "%4s",
      "expectedUnits": [
        37,
        52,
        115
      ]
    },
    {
      "id": "binary-percent-percent-s-is-not-printf",
      "kind": "binary",
      "format": "%%s",
      "value": 1,
      "expectedExpanded": "%\\01\\00\\00\\00",
      "expectedUnits": [
        37,
        1,
        0,
        0,
        0
      ]
    },
    {
      "id": "binary-multiple-exact-placeholders",
      "kind": "binary",
      "format": "%s:%s",
      "value": 1,
      "expectedExpanded": "\\01\\00\\00\\00:\\01\\00\\00\\00",
      "expectedUnits": [
        1,
        0,
        0,
        0,
        58,
        1,
        0,
        0,
        0
      ]
    }
  ],
  "selectorCases": [
    {
      "line": "1[%s]",
      "defaultGroup": 20,
      "expected": {
        "group": 20,
        "variable": 1,
        "format": "[%s]"
      }
    },
    {
      "line": "\\14\\10%s",
      "defaultGroup": 17,
      "expected": {
        "group": 20,
        "variable": 16,
        "format": "%s"
      }
    },
    {
      "line": "\\110raw",
      "defaultGroup": 20,
      "expected": {
        "group": 17,
        "variable": 0,
        "format": "raw"
      }
    },
    {
      "line": "12tail",
      "defaultGroup": 20,
      "expected": {
        "group": 20,
        "variable": 1,
        "format": "2tail"
      }
    },
    {
      "line": "x%s",
      "defaultGroup": 20,
      "expected": {
        "skip": true
      }
    },
    {
      "line": "\\14x",
      "defaultGroup": 17,
      "expected": {
        "skip": true
      }
    }
  ],
  "pageCases": [
    {
      "id": "unknown-header-retains-current-page",
      "lines": [
        ";;Results[2]",
        "0AA",
        ";;Unknown[3]",
        "0BB"
      ],
      "expected": [
        {
          "key": "18:2",
          "lines": [
            "0AA",
            "0BB"
          ]
        }
      ]
    },
    {
      "id": "duplicate-page-appends-and-alias-name-matches",
      "lines": [
        ";;Results[2]",
        "0AA",
        ";;Result[2]",
        "0BB"
      ],
      "expected": [
        {
          "key": "18:2",
          "lines": [
            "0AA",
            "0BB"
          ]
        }
      ]
    },
    {
      "id": "header-spelling-is-case-sensitive",
      "lines": [
        ";;results",
        "0AA",
        ";;Results",
        "0BB"
      ],
      "expected": [
        {
          "key": "18:0",
          "lines": [
            "0BB"
          ]
        }
      ]
    },
    {
      "id": "page-number-prefix-and-no-close-required",
      "lines": [
        ";;Started[12tail",
        "0AA"
      ],
      "expected": [
        {
          "key": "15:12",
          "lines": [
            "0AA"
          ]
        }
      ]
    },
    {
      "id": "page-scan-failure-uses-zero",
      "lines": [
        ";;Started[x]",
        "0AA"
      ],
      "expected": [
        {
          "key": "15:0",
          "lines": [
            "0AA"
          ]
        }
      ]
    },
    {
      "id": "one-unit-lines-ignored-and-semicolon-comments",
      "lines": [
        ";;Results",
        "0",
        ";0AA",
        "0BB"
      ],
      "expected": [
        {
          "key": "18:0",
          "lines": [
            "0BB"
          ]
        }
      ]
    },
    {
      "id": "leading-space-is-format-data",
      "lines": [
        ";;Results",
        " ;;Started",
        "0BB"
      ],
      "expected": [
        {
          "key": "18:0",
          "lines": [
            " ;;Started",
            "0BB"
          ]
        }
      ]
    }
  ]
}
